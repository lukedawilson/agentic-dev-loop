# Custom sandbox image for dotnet construction loops (e.g. the consumer repo).
#
# Same lineage as the default dev image (python:3.12-slim, Debian trixie)
# plus the pieces a dotnet pipeline needs in-sandbox:
#   - libicu76 / libstdc++6: dotnet 10 runtime deps (without them the SDK
#     installs but crashes on startup)
#   - jq:   run-conformance.sh verdict processing
#   - unzip: qa/bundle-and-run.sh export inspection
#   - lsof:  qa/boot-builder.sh stale-listener reaping
#   - fontconfig / fontconfig-config / fonts-liberation: render_check
#     chromium-headless needs /etc/fonts/fonts.conf + Arial-metric fallbacks
#     (skia aborts on font enumeration without them; see planning-docs plan 023)
#   - dotnet SDK 10.0.402 (pin = the version empirically verified against
#     this base image)
#
# Network is per-stage in the engine; this image itself makes no network
# assumptions at runtime.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git nodejs npm coreutils ca-certificates curl \
        libicu76 libstdc++6 jq unzip lsof \
        fontconfig fontconfig-config fonts-liberation \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
        | bash /dev/stdin --version 10.0.402 --install-dir /usr/share/dotnet \
    && ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

CMD ["sleep", "infinity"]
